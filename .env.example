# PostgreSQL connection string.
# For psycopg2 (the driver listed in requirements.txt) use the postgresql:// scheme.
# Example for a local Postgres 18 instance:
DATABASE_URL=postgresql://project1:your_secure_password@localhost:5432/project1

# Secret key used to sign session cookies. Change to a long random string in production.
SESSION_SECRET_KEY=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# Development-only admin seeding
# When both SEED_ADMIN_USERNAME and SEED_ADMIN_PASSWORD are set, the app will
# automatically create this user on startup if they do not already exist.
# Leave these UNSET in production (the feature is disabled when they are absent).
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme
# SEED_ADMIN_ROLE defaults to "admin" when omitted.
# Valid values: admin, pilot, copilot, technician
SEED_ADMIN_ROLE=admin

OPENAI_API_KEY=your-openai-api-key
AVWX_API_KEY=your-avwx-api-key
# OpenWeatherMap: source repo uses OPENWEATHERMAP_API_KEY; app also accepts OWM_API_KEY.
OWM_API_KEY=your-owm-api-key
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
# WeatherAPI: source repo uses WEATHERAPI_API_KEY; app also accepts WEATHERAPI_KEY.
WEATHERAPI_KEY=your-weatherapi-key
WEATHERAPI_API_KEY=your-weatherapi-api-key
WINDY_API_KEY=your-windy-api-key
CHECKWX_API_KEY=your-checkwx-api-key
DEBUG=false

WIND_OK_MAX_KNOTS=15.0
WIND_RISKY_MAX_KNOTS=25.0
VISIBILITY_OK_MIN_KM=5.0
VISIBILITY_RISKY_MIN_KM=1.0
TEMP_OK_MIN_C=0.0
TEMP_OK_MAX_C=40.0
TEMP_RISKY_MIN_C=-5.0
TEMP_RISKY_MAX_C=45.0
HUMIDITY_OK_MAX_PCT=85.0
HUMIDITY_RISKY_MAX_PCT=95.0
CLOUD_BASE_OK_MIN_FT=500.0
CLOUD_BASE_RISKY_MIN_FT=200.0
CLOUD_CEILING_OK_MIN_FT=1000.0
CLOUD_CEILING_RISKY_MIN_FT=500.0
CROSSWIND_OK_MAX_KNOTS=15.0
CROSSWIND_RISKY_MAX_KNOTS=20.0
TAILWIND_OK_MAX_KNOTS=5.0
TAILWIND_RISKY_MAX_KNOTS=10.0
HEADWIND_OK_MAX_KNOTS=25.0
HEADWIND_RISKY_MAX_KNOTS=35.0
